# ─── SWK Ghana frontend environment variables ────────────────────────────────
# Copy this file to `.env` (or set these in your Vercel project settings) and
# fill in real values. All VITE_* vars are embedded in the client bundle, so
# only ever put PUBLIC / publishable keys here — never secret keys.

# ── Browser (VITE_*) — PUBLIC values only ────────────────────────────────────
# Sanity CMS reads. The `production` dataset is publicly readable, so NO token
# is used in the browser. Writes go through the server (see below).
VITE_SANITY_PROJECT_ID=your_sanity_project_id
VITE_SANITY_DATASET=production

# Brevo (newsletter subscriptions)
VITE_BREVO_API_KEY=your_brevo_api_key

# ── Server-only (NO VITE_ prefix) — used by /api/admin serverless function ────
# These are NEVER shipped to the browser. Set them in Vercel → Project →
# Settings → Environment Variables.
#
# Sanity Editor/write token — create at sanity.io/manage → API → Tokens.
# IMPORTANT: revoke the old token that was previously exposed in the client.
SANITY_TOKEN=your_sanity_editor_token
SANITY_PROJECT_ID=your_sanity_project_id
SANITY_DATASET=production
# Admin panel login password (was previously hardcoded in the bundle — change it).
ADMIN_PASSWORD=choose_a_strong_password
# Random secret used to sign admin session tokens (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=long_random_string

# Google Analytics 4 — required for Google Ad Grants conversion tracking.
# Also paste the same ID into index.html (two places).
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Paystack — PUBLIC key only (safe to expose). Enables the "Card & Mobile
# Money" (GH₵) option on the Donate page. Get it at dashboard.paystack.com →
# Settings → API Keys. Until set, donors are guided to bank/MoMo transfer.
VITE_PAYSTACK_PUBLIC_KEY=pk_live_or_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Flutterwave — PUBLIC key only (safe to expose). Enables the "International"
# (USD/GBP/EUR) option on the Donate page. Get it at app.flutterwave.com →
# Settings → API Keys. Until set, international donors are guided to transfer.
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxx-X
